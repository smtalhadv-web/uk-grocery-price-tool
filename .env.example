# Copy to .env.local for development. Never commit a filled-in copy (R9).

# Where reads come from.
#   fixtures — deterministic sample data, no database, no network (default)
#   db       — Postgres, real observed prices
DATA_SOURCE=fixtures

# Postgres connection string. Required only when DATA_SOURCE=db.
# Supabase: Project settings → Database → Connection string → URI
DATABASE_URL=

# Shared secret guarding every job route. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Sent in the fetcher's User-Agent so a retailer can reach you (R6).
FETCH_CONTACT_URL=https://your-domain.example/contact

# Politeness knobs. Raising concurrency or lowering the delay makes a block
# more likely, not less.
FETCH_CONCURRENCY=2
FETCH_DELAY_MS=900

# Minimum score for a name-based cross-store match. Lower means more matches
# and more wrong ones; below this a row is parked for review instead (R5).
MATCH_CONFIDENCE_FLOOR=0.86

# A price older than this is shown as stale rather than current (R2).
STALE_AFTER_HOURS=36
